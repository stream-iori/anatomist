{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antcodes.dev/anatomist/schema/semantic-stream-v1.schema.json",
  "title": "Anatomist semantic-stream/v1 record",
  "type": "object",
  "required": ["record", "contract", "index_revision_id", "semantic_profile_id"],
  "properties": {
    "record": {
      "enum": [
        "entity_candidate", "entity", "declaration", "containment", "type_relation",
        "callable_relation", "binding_relation", "reference_site", "call_site",
        "dispatch_target", "access_site", "control_region", "trace", "source_slice",
        "artifact", "config_entity", "annotation", "document_relation", "evidence"
      ]
    },
    "contract": { "const": "semantic-stream/v1" },
    "seed_id": { "type": "string", "minLength": 1 },
    "parent_seed_id": { "type": "string", "minLength": 1 },
    "index_revision_id": { "type": "string", "pattern": "^rev:" },
    "source_snapshot_id": { "type": "string", "minLength": 1 },
    "semantic_profile_id": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "domain": { "enum": ["language", "configuration", "documentation", "build"] },
    "language": { "type": "string" },
    "kind": { "type": "string" },
    "origin": { "enum": ["extracted", "configured", "derived", "observed"] },
    "resolution_status": { "enum": ["exact", "heuristic", "ambiguous", "unresolved"] },
    "scope": { "type": "string" },
    "status": { "enum": ["positive", "empty", "partial", "unsupported"] },
    "coverage": { "enum": ["complete", "partial", "unknown", "unsupported"] },
    "truncated": { "type": "boolean" },
    "negative_conclusion_safe": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "record": { "const": "evidence" } } },
      "then": {
        "required": ["scope", "status", "coverage", "truncated", "negative_conclusion_safe"]
      },
      "else": { "required": ["seed_id", "id"] }
    }
  ],
  "additionalProperties": true
}
